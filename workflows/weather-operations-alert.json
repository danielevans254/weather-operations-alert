    {
      "parameters": {
        "jsCode": "const req=$('Normalize Weather Request').first().json; const weather=$('Fetch Weather Forecast').first().json.body ?? $('Fetch Weather Forecast').first().json; const air=$input.first().json.body ?? $input.first().json; return [{json:{forecast:{location:req.location,forecast_date:weather.daily?.time?.[0] || null,max_temperature_c:weather.daily?.temperature_2m_max?.[0],min_temperature_c:weather.daily?.temperature_2m_min?.[0],precipitation_probability:weather.daily?.precipitation_probability_max?.[0],wind_speed_kph:weather.daily?.wind_speed_10m_max?.[0],air_quality_index:air.current?.us_aqi}}}];"
      },
      "id": "30b8e0be-04c4-4a33-bf2d-1513ee73e778",
      "name": "Combine Weather Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        120
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "const evaluate = function evaluateWeatherRisk(forecast, thresholds = {}) {\n  const data = forecast && typeof forecast === 'object' ? forecast : {};\n  const limit = {\n    heat_c: Number(thresholds.heat_c ?? 35),\n    rain_probability: Number(thresholds.rain_probability ?? 70),\n    wind_kph: Number(thresholds.wind_kph ?? 50),\n    air_quality_index: Number(thresholds.air_quality_index ?? 100),\n  };\n  const metrics = {\n    max_temperature_c: Number(data.max_temperature_c),\n    min_temperature_c: Number(data.min_temperature_c),\n    precipitation_probability: Number(data.precipitation_probability),\n    wind_speed_kph: Number(data.wind_speed_kph),\n    air_quality_index: Number(data.air_quality_index),\n  };\n  const alerts = [];\n  if (Number.isFinite(metrics.max_temperature_c) && metrics.max_temperature_c >= limit.heat_c) {\n    alerts.push({ type: 'heat', severity: metrics.max_temperature_c >= limit.heat_c + 5 ? 'high' : 'medium', value: metrics.max_temperature_c, threshold: limit.heat_c });\n  }\n  if (Number.isFinite(metrics.precipitation_probability) && metrics.precipitation_probability >= limit.rain_probability) {\n    alerts.push({ type: 'rain', severity: metrics.precipitation_probability >= 90 ? 'high' : 'medium', value: metrics.precipitation_probability, threshold: limit.rain_probability });\n  }\n  if (Number.isFinite(metrics.wind_speed_kph) && metrics.wind_speed_kph >= limit.wind_kph) {\n    alerts.push({ type: 'wind', severity: metrics.wind_speed_kph >= limit.wind_kph * 1.5 ? 'high' : 'medium', value: metrics.wind_speed_kph, threshold: limit.wind_kph });\n  }\n  if (Number.isFinite(metrics.air_quality_index) && metrics.air_quality_index >= limit.air_quality_index) {\n    alerts.push({ type: 'air_quality', severity: metrics.air_quality_index >= 150 ? 'high' : 'medium', value: metrics.air_quality_index, threshold: limit.air_quality_index });\n  }\n  return {\n    location: String(data.location || 'Configured location'),\n    forecast_date: data.forecast_date || null,\n    metrics,\n    thresholds: limit,\n    alerts,\n    alert_count: alerts.length,\n    severity: alerts.some((a) => a.severity === 'high') ? 'high' : alerts.length ? 'medium' : 'none',\n  };\n};\nconst req=$('Normalize Weather Request').first().json;\nconst result=evaluate($input.first().json.forecast ?? $input.first().json,req.thresholds);\nreturn [{json:{...req,...result}}];"
      },
      "id": "ffb8a912-1255-41e8-9b44-1e07d94d1eb8",
      "name": "Evaluate Weather Risk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        0
      ],
      "notesInFlow": true,
      "notes": "Pure threshold engine keeps operational decisions deterministic and auditable."
    },
    {
      "parameters": {
        "jsCode": "const d=$input.first().json; const detail=d.alerts.map(a=>'- '+a.type+': '+a.value+' (threshold '+a.threshold+', '+a.severity+')').join('\\n'); const text='Weather operations check — '+d.location+'\\nSeverity: '+d.severity+'\\n'+(detail || 'No thresholds exceeded.'); return [{json:{...d,notification_text:text}}];"
      },
